---
import { typingRoles } from '../data/resume';
import { site, withBase } from '../data/site';
import Icon from './Icon.astro';

const rolesJson = JSON.stringify(typingRoles);
const nameParts = site.author.name.split(' ');
const firstName = nameParts.shift() ?? '';
const lastName = nameParts.join(' ');
---

<section class="hero">
  <div class="stars" aria-hidden="true"></div>
  <div class="container hero-inner">
    <div>
      <p class="hero-greeting">Hello, I'm</p>
      <h1>{firstName} {lastName && <span class="accent">{lastName}</span>}</h1>
      <p class="hero-typed">
        <span class="typed" id="typed-roles" data-roles={rolesJson}></span><span class="typed-cursor" aria-hidden="true">▍</span>
      </p>

      <p class="hero-bio">
        Curtis Aube is a thoughtful and creative person who enjoys solving problems, digging into to details, and finding new ways to approach challenges. He brings that creativity to everything he does, from professional software development to creatively sharing his faith through puppetry.
        <br><br>
        Inspired by the possibilities of computers from a young age, Curtis began programming games in middle school in 1999 and continued exploring programming and web development throughout high school. He earned a bachelor’s degree in computer engineering from Vermont Technical College and began his professional software engineering career in 2007. Since then, he has passionately applied his skills to projects ranging from enterprise software to video games.
        <br><br>
        Curtis currently works as a Software Engineer at Union Street Media and runs a Bible-based YouTube channel called <a href="https://www.youtube.com/channel/UCIY018sQthdCDCeNLhhNUfA">Bible Block</a>.
      </p>

      <div class="social-row">
        {Object.values(site.socials).map((s) => (
          <a class="social-link" href={withBase(s.url)} target={s.url.startsWith('http') ? '_blank' : undefined} rel="noopener">
            {s.icon && <Icon name={s.icon} />}
            {s.label}
          </a>
        ))}
      </div>
    </div>

    <img class="hero-avatar" src={withBase('/img/avatar.jpg')} alt={`Portrait of ${site.author.name}`} width="220" height="220" />
  </div>
</section>

<script>
  const el = document.getElementById('typed-roles');
  if (el) {
    const roles: string[] = JSON.parse(el.dataset.roles ?? '[]');
    let roleIndex = 0;
    let charIndex = 0;
    let deleting = false;

    const tick = () => {
      const word = roles[roleIndex];
      if (!deleting) {
        charIndex++;
        el.textContent = word.slice(0, charIndex);
        if (charIndex === word.length) {
          deleting = true;
          setTimeout(tick, 1800);
          return;
        }
        setTimeout(tick, 70);
      } else {
        charIndex--;
        el.textContent = word.slice(0, charIndex);
        if (charIndex === 0) {
          deleting = false;
          roleIndex = (roleIndex + 1) % roles.length;
          setTimeout(tick, 350);
          return;
        }
        setTimeout(tick, 35);
      }
    };

    tick();
  }
</script>
